    <!-- Privacy -->
    <string name="privacy_title">Privacidade</string>
    <string name="privacy_hint">O que o MyFinance guarda e envia</string>
    <string name="privacy_storage_title">Seus dados ficam neste celular</string>
    <string name="privacy_storage">Transações, saldos, ativos, avaliações, cotações e configurações ficam só no armazenamento privado do MyFinance, protegidos pelo isolamento de apps e pela criptografia de arquivos do Android. Não há conta nem servidor.</string>
    <string name="privacy_network_title">Uma única requisição de rede</string>
    <string name="privacy_network">Para converter dólares, o MyFinance pede ao Banco Central do Brasil (api.bcb.gov.br) a PTAX pública de um intervalo de datas, por HTTPS. Nada sobre você ou seu dinheiro é enviado. Você pode desligar a busca automática em Moeda e cotação.</string>
    <string name="privacy_backup_title">Backups criptografados</string>
    <string name="privacy_backup">Os backups são criptografados com AES-256 e uma chave derivada da sua senha de recuperação antes de saírem do app. A senha nunca é guardada. Exportações CSV não são criptografadas.</string>
    <string name="privacy_tracking_title">Sem rastreamento</string>
    <string name="privacy_tracking">Sem anúncios, sem analytics, sem relatório de falhas. Valores, nomes e observações nunca vão para logs.</string>

