<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: the MyFinance symbol on the brand background, then the app theme. -->
    <style name="Theme.MyFinance.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/myfinance_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyFinance</item>
    </style>

    <style name="Theme.MyFinance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/myfinance_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
